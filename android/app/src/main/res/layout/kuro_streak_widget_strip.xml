<?xml version="1.0" encoding="utf-8"?>
<!--
  Kuro streak launcher widget — 4x1 Compact Strip (Exact match to HTML prototype w4x1):
  Single horizontal row:
  1. Left: Big 26sp streak number stacked above "day streak" label.
  2. Middle: 7 rounded-square day chips (Mo..Su / Sn..Mn inside each 28dp chip).
  3. Right: 52dp Kuro mascot.
  Wrapped in a centered 74dp ribbon so widget picker preview also renders sleek 4x1 proportions.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:background="@drawable/kuro_widget_bg"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <!-- Left: Stacked big streak number + unit label -->
        <LinearLayout
            android:id="@+id/widget_left_column"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="62dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_streak_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="0"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#F1958E" />

            <TextView
                android:id="@+id/widget_streak_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/streak_days_unit"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#9E948C"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_mood_subtitle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_week_summary"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Middle: 7 rounded-square day chips (Mo..Su / Sn..Mn inside the chip) -->
        <LinearLayout
            android:id="@+id/widget_week_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:orientation="horizontal"
            android:weightSum="7"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/day_dot_1"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:background="@drawable/kuro_chip_unchecked_bg"
                android:gravity="center"
                android:text="@string/streak_day_1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#9E948C" />

            <TextView
                android:id="@+id/day_dot_2"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:background="@drawable/kuro_chip_unchecked_bg"
                android:gravity="center"
                android:text="@string/streak_day_2"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#9E948C" />

            <TextView
                android:id="@+id/day_dot_3"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:background="@drawable/kuro_chip_unchecked_bg"
                android:gravity="center"
                android:text="@string/streak_day_3"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#9E948C" />

            <TextView
                android:id="@+id/day_dot_4"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:background="@drawable/kuro_chip_unchecked_bg"
                android:gravity="center"
                android:text="@string/streak_day_4"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#9E948C" />

            <TextView
                android:id="@+id/day_dot_5"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:background="@drawable/kuro_chip_unchecked_bg"
                android:gravity="center"
                android:text="@string/streak_day_5"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#9E948C" />

            <TextView
                android:id="@+id/day_dot_6"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:background="@drawable/kuro_chip_unchecked_bg"
                android:gravity="center"
                android:text="@string/streak_day_6"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#9E948C" />

            <TextView
                android:id="@+id/day_dot_7"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:background="@drawable/kuro_chip_unchecked_bg"
                android:gravity="center"
                android:text="@string/streak_day_7"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#9E948C" />
        </LinearLayout>

        <!-- Right: 52dp Kuro mascot -->
        <ImageView
            android:id="@+id/widget_kuro_mood"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/kuro_tsundere"
            android:contentDescription="Kuro mood" />
    </LinearLayout>
</FrameLayout>
